{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "waifutagger",
    "version": "0.1.0",
    "identifier": "com.kuzulabz.waifuitagger",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:8081",
        "beforeDevCommand": "bun start",
        "beforeBuildCommand": "bun run build:web"
    },
    "app": {
        "windows": [
            {
                "title": "WaifuTagger",
                "width": 1200,
                "height": 1000,
                "resizable": true,
                "fullscreen": false,
                "dragDropEnabled": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "app",
            "appimage",
            "deb",
            "nsis",
            "rpm"
        ],
        "createUpdaterArtifacts": true,
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    },
    "plugins": {
        "updater": {
            "pubkey": "CONTENT FROM PUBLICKEY.PEM",
            "endpoints": [
                "https://github.com/KuzuLabz/WaifuTagger/releases/latest/download/latest.json"
            ]
        }
    }
}